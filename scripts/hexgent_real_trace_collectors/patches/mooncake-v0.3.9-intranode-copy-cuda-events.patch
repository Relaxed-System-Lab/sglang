+static bool hexgentCudaCopyTelemetryEnabled() {
+    static const bool enabled = []() {
+        const char *value = std::getenv("MC_HEXGENT_CUDA_COPY_TELEMETRY");
+        return value != nullptr && std::string(value) != "0" &&
+               std::string(value) != "false";
+    }();
+    return enabled;
+}
+
+static int pointerDevice(const void *address) {
+    cudaPointerAttributes attributes{};
+    cudaError_t status = cudaPointerGetAttributes(&attributes, address);
+    if (status != cudaSuccess) {
+        cudaGetLastError();
+        return -1;
+    }
+    return attributes.device;
+}
+
+static cudaError_t timedCudaMemcpy(void *destination, const void *source,
+                                   size_t length, const void *local_address,
+                                   const char *copy_context,
+                                   double *batch_copy_ms,
+                                   uint64_t *batch_copy_bytes,
+                                   uint64_t *batch_copy_count) {
+    if (!hexgentCudaCopyTelemetryEnabled()) {
+        return cudaMemcpy(destination, source, length, cudaMemcpyDefault);
+    }
+
+    const int source_device = pointerDevice(source);
+    const int destination_device = pointerDevice(destination);
+    const int local_device = pointerDevice(local_address);
+    int previous_device = -1;
+    cudaGetDevice(&previous_device);
+    if (local_device >= 0 && local_device != previous_device) {
+        cudaError_t set_status = cudaSetDevice(local_device);
+        if (set_status != cudaSuccess) {
+            LOG(WARNING) << "[HEXGENT_CUDA_COPY] context=" << copy_context
+                         << " telemetry_error=cudaSetDevice"
+                         << " status=" << cudaGetErrorString(set_status);
+            return cudaMemcpy(destination, source, length, cudaMemcpyDefault);
+        }
+    }
+
+    cudaEvent_t start_event = nullptr;
+    cudaEvent_t end_event = nullptr;
+    cudaError_t start_create = cudaEventCreate(&start_event);
+    cudaError_t end_create = cudaEventCreate(&end_event);
+    if (start_create != cudaSuccess || end_create != cudaSuccess) {
+        if (start_event != nullptr) cudaEventDestroy(start_event);
+        if (end_event != nullptr) cudaEventDestroy(end_event);
+        cudaError_t copy_status =
+            cudaMemcpy(destination, source, length, cudaMemcpyDefault);
+        if (previous_device >= 0 && previous_device != local_device) {
+            cudaSetDevice(previous_device);
+        }
+        return copy_status;
+    }
+
+    cudaError_t start_status = cudaEventRecord(start_event, 0);
+    cudaError_t copy_status =
+        cudaMemcpy(destination, source, length, cudaMemcpyDefault);
+    cudaError_t end_status = cudaEventRecord(end_event, 0);
+    cudaError_t sync_status = cudaEventSynchronize(end_event);
+    float elapsed_ms = 0.0f;
+    cudaError_t elapsed_status =
+        cudaEventElapsedTime(&elapsed_ms, start_event, end_event);
+
+    const bool measured = start_status == cudaSuccess &&
+                          end_status == cudaSuccess &&
+                          sync_status == cudaSuccess &&
+                          elapsed_status == cudaSuccess;
+    if (measured) {
+        const double gib_per_second = elapsed_ms > 0.0f
+                                          ? (static_cast<double>(length) /
+                                             (1024.0 * 1024.0 * 1024.0)) /
+                                                (elapsed_ms / 1000.0)
+                                          : 0.0;
+        LOG(INFO) << "[HEXGENT_CUDA_COPY] context=" << copy_context
+                  << " bytes=" << length << " elapsed_ms=" << elapsed_ms
+                  << " gib_per_second=" << gib_per_second
+                  << " source_device=" << source_device
+                  << " destination_device=" << destination_device
+                  << " execution_device=" << local_device;
+        *batch_copy_ms += elapsed_ms;
+        *batch_copy_bytes += length;
+        *batch_copy_count += 1;
+    } else {
+        LOG(WARNING) << "[HEXGENT_CUDA_COPY] context=" << copy_context
+                     << " telemetry_error=cuda_event"
+                     << " start=" << cudaGetErrorString(start_status)
+                     << " end=" << cudaGetErrorString(end_status)
+                     << " sync=" << cudaGetErrorString(sync_status)
+                     << " elapsed=" << cudaGetErrorString(elapsed_status);
+    }
+
+    cudaEventDestroy(start_event);
+    cudaEventDestroy(end_event);
+    if (previous_device >= 0 && previous_device != local_device) {
+        cudaSetDevice(previous_device);
+    }
+    return copy_status;
+}
+
+static void logCudaCopyBatch(const char *copy_context, uint64_t copy_count,
+                             uint64_t copy_bytes, double copy_ms) {
+    if (!hexgentCudaCopyTelemetryEnabled() || copy_count == 0) return;
+    const double gib_per_second = copy_ms > 0.0
+                                      ? (static_cast<double>(copy_bytes) /
+                                         (1024.0 * 1024.0 * 1024.0)) /
+                                            (copy_ms / 1000.0)
+                                      : 0.0;
+    LOG(INFO) << "[HEXGENT_CUDA_COPY_BATCH] context=" << copy_context
+              << " copies=" << copy_count << " bytes=" << copy_bytes
+              << " cuda_copy_sum_ms=" << copy_ms
+              << " gib_per_second=" << gib_per_second;
+}
