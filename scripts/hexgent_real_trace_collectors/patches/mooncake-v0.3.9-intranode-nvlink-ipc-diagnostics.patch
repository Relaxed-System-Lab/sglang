+static std::string ipcHandleFingerprint(const cudaIpcMemHandle_t &handle) {
+    const auto *bytes = reinterpret_cast<const unsigned char *>(&handle);
+    std::ostringstream stream;
+    stream << std::hex << std::setfill('0');
+    for (size_t index = 0; index < sizeof(cudaIpcMemHandle_t); ++index) {
+        stream << std::setw(2) << static_cast<unsigned int>(bytes[index]);
+    }
+    return stream.str();
+}
+
+static void logIpcContext(const char *operation, void *address) {
+    int current_device = -1;
+    cudaError_t device_status = cudaGetDevice(&current_device);
+    cudaPointerAttributes attributes{};
+    cudaError_t pointer_status = cudaPointerGetAttributes(&attributes, address);
+    LOG(INFO) << "[HEXGENT_IPC_DEBUG] operation=" << operation
+              << " current_device=" << current_device
+              << " cudaGetDevice=" << cudaGetErrorString(device_status)
+              << " address=" << address
+              << " pointer_status=" << cudaGetErrorString(pointer_status)
+              << " pointer_device=" << attributes.device
+              << " pointer_type=" << attributes.type;
+}
